# Copy to backend/.env and fill in. backend/.env is gitignored: never commit real values.

DATABASE_URL=postgresql://wasac_user:wasac_pass@localhost:5432/wasac_db
# Production refuses to start without an explicit DATABASE_URL. Render is detected automatically.
# APP_ENV=production
# Signs staff and household sessions; any long random string. Without it, everyone is signed out on restart.
WASAC_AUTH_SECRET=

# Household sign-in: show codes on screen for DEMO- households while SMS is not wired (0 to turn off).
OTP_SHOW_DEMO_CODES=1
# Location check: metres from the meter, and the roughest phone position still trusted.
LOCATION_MAX_M=150
LOCATION_MAX_ACCURACY_M=500
# Leak alert (provisional): a billed period at this many times the usual daily use, and at least
# this many m3 above it, tells the household to check for leaks. It never holds a reading.
# ANOMALY_LEAK_RATIO=1.5
# ANOMALY_LEAK_MIN_EXTRA_M3=3

# Model weights (private): one link per file, e.g. Google Drive share links.
MODEL_URLS=best.pt=,meter_reader.pt=,quality_gate.pt=
# Or, if the weights are ever published in one place:
# MODEL_BASE_URL=

# Africa's Talking (SMS). AT_USERNAME=sandbox: messages appear in the simulator
# (simulator.africastalking.com), not on phones, and are free. Unset: SMS are only logged.
AT_USERNAME=
AT_API_KEY=
# Optional, live only: an approved sender name.
AT_SENDER_ID=

# MTN Mobile Money (Collections). Unset: payments are simulated. Sandbox setup:
# put the Collections primary key here, then run scripts/momo_sandbox_setup.py for the other two.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# MOMO_TARGET_ENVIRONMENT=sandbox   MOMO_CURRENCY=EUR (sandbox) / RWF (live)

# Africa's Talking USSD: the callback URL is https://<api>/ussd?token=<this>. Any long random string.
USSD_CALLBACK_TOKEN=

# How long meter photos are kept for the officers who check readings (days).
# PHOTO_RETENTION_DAYS=90
# Cleanup runs on API startup and hourly while awake. Also schedule scripts/purge_photos.py
# independently if hosting sleeps. The scheduler must have the same DATABASE_URL.
# PHOTO_CLEANUP_INTERVAL_SECONDS=3600

# Phone alerts (web push). Make the pair once: python scripts/make_vapid_keys.py (writes them here).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:support@mubazi.rw

# MoMo Pay by USSD (used when the MoMo API keys above are not set): WASAC's merchant code.
# MOMO_PAY_CODE=
# How it is dialled, {code} and {amount} filled in (default shown):
# MOMO_PAY_USSD=*182*8*1*{code}*{amount}#
# PAYMENTS_SIMULATE=1 marks bills paid at once (tests and demos only).
